// FakeShadow Shader - Simplified for Cocos Creator 3.8.7

CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: fakeshadow-vs:vert
      frag: fakeshadow-fs:frag
      properties: &props
        mainTexture:     { value: white, editor: { displayName: "Shadow Texture" } }
        color:           { value: [0.5, 0.5, 0.5, 1.0], editor: { type: color } }
        colorDropShadow: { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: back
}%

CCProgram fakeshadow-vs %{
  precision highp float;

  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec2 v_uv;

  vec2 getObjectScaleXZ(mat4 m) {
    vec3 col0 = vec3(m[0].x, m[1].x, m[2].x);
    vec3 col2 = vec3(m[0].z, m[1].z, m[2].z);
    return vec2(length(col0), length(col2));
  }

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec2 objScale = max(getObjectScaleXZ(matWorld), vec2(1e-6));

    vec3 p = position.xyz;
    p.x /= objScale.x;
    p.z /= objScale.y;

    if (objScale.x <= objScale.y) {
      p.x *= objScale.x;
      p.z *= objScale.x;
      if (position.y > 0.0) {
        p.y += (objScale.y - objScale.x) / (objScale.y * 2.0);
      } else {
        p.y -= (objScale.y - objScale.x) / (objScale.y * 2.0);
      }
    } else {
      p.x *= objScale.y;
      p.z *= objScale.y;
      if (position.x > 0.0) {
        p.x += (objScale.x - objScale.y) / (objScale.x * 2.0);
      } else {
        p.x -= (objScale.x - objScale.y) / (objScale.x * 2.0);
      }
    }

    vec4 pos = position;
    pos.xyz = p;
    v_uv = a_texCoord;

    return cc_matProj * (cc_matView * matWorld) * pos;
  }
}%

CCProgram fakeshadow-fs %{
  precision highp float;

  in vec2 v_uv;
  uniform sampler2D mainTexture;

  uniform Constants {
    vec4 color;
    vec4 colorDropShadow;
  };

  vec4 frag () {
    vec2 mask = texture(mainTexture, v_uv).xy;
    float a = mask.x * colorDropShadow.a;
    vec3 rgb = mix(colorDropShadow.rgb, color.rgb, mask.y);
    return vec4(rgb, a);
  }
}%
