// Merged-mesh variant of cubeColor.effect.
//
// cubeColor.effect renders one node per cube and gets its two tones from the
// instanced attributes a_instColor / a_instColorShadow. A merged grid mesh has
// no instances, so both tones arrive as per-vertex streams instead.
//
// The scale "un-stretch" block from cubeColor-vs is gone on purpose: the mesh
// builder bakes the Render node's (1.107, 1.835, 1.107) scale and the CubeRoot
// rotation straight into the vertices, so the geometry that arrives here is
// already final. a_capLocal carries the pre-baked vector that the original
// derived from the adjusted local position, so the fake-SSS term is unchanged.

CCEffect %{
  techniques:
  - name: cubeColorMerged
    passes:
    - vert: cubeColorMerged-vs:vert
      frag: cubeColorMerged-fs:frag

      properties: &props
        _MatCap:       { value: black }
      rasterizerState:
        cullMode: back
      blendState:
        targets:
          - blend: false
}%

CCProgram cubeColorMerged-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #pragma format(RGBA8)
  in lowp vec4 a_color;
  #pragma format(RGBA8)
  in lowp vec4 a_colorShadow;
  // Baked per source vertex: ((R * (S * (localPos - vec3(0, 0.5, 0)))) / S),
  // i.e. exactly the value cubeColor-vs computed as `worldPosNoTrans`.
  in vec3 a_capLocal;

  out mediump vec4 v_cap; // xy: matcap by normal, zw: matcap by adjusted pos
  out mediump vec3 v_worldNormal;
  out lowp vec4 v_color;
  out lowp vec4 v_colorShadow;

  // Compute object scale from world matrix columns
  vec3 getObjectScale(mat4 m) {
    vec3 sx = vec3(m[0].x, m[1].x, m[2].x);
    vec3 sy = vec3(m[0].y, m[1].y, m[2].y);
    vec3 sz = vec3(m[0].z, m[1].z, m[2].z);
    return vec3(length(sx), length(sy), length(sz));
  }

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    // View-space normal for matcap (matching Unity)
    vec3 worldNormal = (matWorldIT * vec4(a_normal, 0.0)).xyz;
    worldNormal = normalize(worldNormal);
    v_worldNormal = worldNormal;
    vec3 viewNormal = normalize((cc_matView * vec4(worldNormal, 0.0)).xyz);
    v_cap.xy = clamp(vec2(viewNormal.x, -viewNormal.y) * 0.5 + 0.5, 0.0, 1.0);

    // Second matcap coord. a_capLocal is already the per-cube adjusted local
    // vector, so only the holder's own rotation/scale still has to be applied.
    vec3 holderScale = getObjectScale(matWorld);
    vec4 capWorld = matWorld * vec4(a_capLocal, 1.0);
    vec3 capNoTrans = capWorld.xyz - vec3(matWorld[3].x, matWorld[3].y, matWorld[3].z);
    capNoTrans /= holderScale;
    vec3 viewPos = (cc_matView * vec4(capNoTrans, 0.0)).xyz;
    v_cap.zw = clamp(vec2(viewPos.x, -viewPos.y) + 0.5, 0.0, 1.0);

    v_color = a_color;
    v_colorShadow = a_colorShadow;

    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram cubeColorMerged-fs %{
  precision highp float;
  #include <legacy/output>

  in mediump vec4 v_cap;
  in mediump vec3 v_worldNormal;
  in lowp vec4 v_color;
  in lowp vec4 v_colorShadow;
  uniform sampler2D _MatCap;

  vec4 frag () {
    vec2 mask = texture(_MatCap, v_cap.xy).xy;
    float sss = texture(_MatCap, v_cap.zw).z;

    vec3 mainColor = v_color.rgb;
    vec3 shadowColor = v_colorShadow.rgb;

    vec3 final = mix(shadowColor, mainColor, mask.y);
    final += (final + 0.2) * mask.x * 0.2;
    final += final * sss * 0.22;

    float lighting = dot(normalize(vec3(0.0, 0.5915, 0.5245)), normalize(v_worldNormal));
    lighting = smoothstep(1.0, 0.0, lighting);
    final = clamp(mix(final, shadowColor * final * 1.1, lighting * 0.67) , 0.0, 1.0);

    return vec4(final, 1.0);
  }
}%
