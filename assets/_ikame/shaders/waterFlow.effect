CCEffect %{
  techniques:
  - name: waterFlow
    passes:
    - vert: waterFlow-vs:vert
      frag: waterFlow-fs:frag
      properties:
        _NormalWater:    { value: grey, editor: { displayName: "Normal Water" } }
        _NormalWater_ST: { value: [1.0, 1.0, 0.1, 0.15], editor: { displayName: "Normal Tiling & Speed" } }
        _NoiseMap:       { value: black, editor: { displayName: "Noise Texture" } }
        _NoiseMap_ST:    { value: [1.0, 1.0, 0.1, 0.1], editor: { displayName: "Noise Tiling & Speed" } }
        _Highlight:      { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color, displayName: "Highlight Color" } }
        _Base:           { value: [0.5, 0.5, 0.5, 1.0], editor: { type: color, displayName: "Base Color" } }
        _Shadow:         { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color, displayName: "Shadow Color" } }
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
          - blend: true
            blendSrc: src_alpha
            blendDst: one_minus_src_alpha
}%

CCProgram waterFlow-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out vec4 v_uv; // xy: uv, zw: world xz * 0.5

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);

    // Calculate world position
    vec4 worldPos = matWorld * position;

    // Unity: o.uv.xy = v.uv; o.uv.zw = v.vertex.xz*0.5;
    v_uv.xy = a_texCoord;
    v_uv.zw = position.xz * 0.5;

    return cc_matViewProj * worldPos;
  }
}%

CCProgram waterFlow-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec4 v_uv;

  uniform sampler2D _NormalWater;
  uniform sampler2D _NoiseMap;

  uniform TexCoords {
    vec4 _NormalWater_ST;
    vec4 _NoiseMap_ST;
  };

  uniform Colors {
    vec4 _Highlight;
    vec4 _Base;
    vec4 _Shadow;
  };

  // Unpack normal map (simplified for Cocos - assumes normal map in tangent space)
  vec3 unpackNormal(vec4 packednormal) {
    vec3 normal;
    normal.xy = packednormal.xy * 2.0 - 1.0;
    normal.z = sqrt(1.0 - clamp(dot(normal.xy, normal.xy), 0.0, 1.0));
    return normal;
  }

  vec4 frag () {
    // Unity: half2 uv = i.uv.xy;
    vec2 uv = v_uv.xy;
    
    // Unity: fixed noiseUV = tex2D(_NoiseMap, uv*0.2 + frac(_Time.y*fixed2(0,0.1))).y;
    float noiseUV = texture(_NoiseMap, uv * 0.2 + fract(cc_time.x * vec2(0.0, 0.1))).y;
    
    // Unity: uv += noiseUV*0.1;
    uv += noiseUV * 0.1;
    
    // Unity: normal1 = UnpackNormal(tex2D(_NormalWater,(i.uv.zw + noiseUV*0.1)*_NormalWater_ST.xy + frac(_Time.y*_NormalWater_ST.zw*0.1)));
    vec3 normal1 = unpackNormal(texture(_NormalWater, (v_uv.zw + noiseUV * 0.1) * _NormalWater_ST.xy + fract(cc_time.x * _NormalWater_ST.zw * 0.1)));
    
    // Unity: normal2 = UnpackNormal(tex2D(_NormalWater,(i.uv.zw + noiseUV*0.1)*_NormalWater_ST.xy - frac(_Time.y*_NormalWater_ST.zw*0.1)));
    vec3 normal2 = unpackNormal(texture(_NormalWater, (v_uv.zw + noiseUV * 0.1) * _NormalWater_ST.xy - fract(cc_time.x * _NormalWater_ST.zw * 0.1)));
    
    // Unity: fixed lighting = saturate(dot(normalize((normal1+normal2)/2),normalize(half3(0.5,0.5,0.0))));
    float lighting = clamp(dot(normalize((normal1 + normal2) / 2.0), normalize(vec3(0.5, 0.5, 0.0))), 0.0, 1.0);
    
    // Unity: fixed highlight1 = tex2D(_NoiseMap, uv*_NoiseMap_ST.xy + frac(_Time.y*_NoiseMap_ST.zw)).x;
    float highlight1 = texture(_NoiseMap, uv * _NoiseMap_ST.xy + fract(cc_time.x * _NoiseMap_ST.zw)).x;
    
    // Unity: fixed highlight2 = tex2D(_NoiseMap, uv*_NoiseMap_ST.xy + frac(_Time.y*_NoiseMap_ST.zw)+0.5).x;
    float highlight2 = texture(_NoiseMap, uv * _NoiseMap_ST.xy + fract(cc_time.x * _NoiseMap_ST.zw) + 0.5).x;
    
    // Unity: fixed highlight = lerp(highlight1,highlight2,sin(_Time.y*2)*0.5+0.5)+smoothstep(0.38,0.5,distance(0.5,uv.y-0.025));
    float highlight = mix(highlight1, highlight2, sin(cc_time.x * 2.0) * 0.5 + 0.5) + smoothstep(0.38, 0.5, distance(0.5, uv.y - 0.025));
    
    // Unity: color = lerp(_Base,_Shadow,lighting);
    vec4 color = vec4(1.0);
    color = mix(_Base, _Shadow, lighting);
    
    // Unity: color = lerp(color,_Highlight,highlight);
    color = mix(color, _Highlight, highlight);
    
    return color;
  }
}%
