CCEffect %{
  techniques:
  - name: cubeColor
    passes:
    - vert: cubeColor-vs:vert
      frag: cubeColor-fs:frag

      properties: &props
        _Color:        { value: [0.5, 0.5, 0.5, 1.0], editor: { type: color } }
        _ColorShadow:  { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
        _Matcap:       { value: black }
        _MainTex:      { value: white }
      rasterizerState:
        cullMode: back
      blendState:
        targets:
          - blend: false
}%

CCProgram cubeColor-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out mediump vec4 v_cap; // xy: matcap coords, zw: uv coords

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    // Transform normal to view space for matcap
    vec3 worldNormal = normalize((matWorldIT * vec4(a_normal, 0.0)).xyz);
    vec3 viewNormal = normalize((cc_matView * vec4(worldNormal, 0.0)).xyz);
    
    // Flip Z to account for Cocos' reversed Z-axis compared to Unity
    viewNormal.z = -viewNormal.z;
    
    // Convert view-space normal to matcap UV coordinates
    v_cap.xy = viewNormal.xy * 0.5 + 0.5;
    
    // Pass through UV coordinates
    v_cap.zw = a_texCoord;

    // Output clip position
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram cubeColor-fs %{
  precision highp float;

  in mediump vec4 v_cap;
  uniform sampler2D _Matcap;
  uniform sampler2D _MainTex;

  uniform Constant {
    vec4 _Color;
    vec4 _ColorShadow;
  };

  vec4 frag () {
    // Sample matcap texture with normal-based UVs
    vec2 matcapUV = clamp(v_cap.xy, 0.0, 1.0);
    vec2 mask = texture(_Matcap, matcapUV).xy;
    
    // Sample main texture with mesh UVs
    vec2 mainUV = v_cap.zw;
    float ambient = texture(_MainTex, mainUV).x;
    
    // Calculate final color using Unity's logic
    vec3 col = mix(_Color.rgb, _ColorShadow.rgb, mask.x);
    col += (_Color.rgb + 0.2) * mask.y * 2.0 * ambient;
    col = mix(pow(clamp(_ColorShadow.rgb, 0.0, 1.0), vec3(1.5)), col, ambient);
    
    return vec4(col, 1.0);
  }
}%
