CCEffect %{
  techniques:
  - name: cubeColor
    passes:
    - vert: cubeColor-vs:vert
      frag: cubeColor-fs:frag

      properties: &props
        _Color:        { value: [0.5, 0.5, 0.5, 1.0], editor: { type: color } }
        _ColorShadow:  { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
        _MatCap:       { value: black }
      rasterizerState:
        cullMode: back
      blendState:
        targets:
          - blend: false
}%

CCProgram cubeColor-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out mediump vec4 v_cap; // xy: matcap by normal, zw: matcap by adjusted pos
  out mediump vec3 v_worldNormal;

  // Compute object scale from world matrix columns
  vec3 getObjectScale(mat4 m) {
    vec3 sx = vec3(m[0].x, m[1].x, m[2].x);
    vec3 sy = vec3(m[0].y, m[1].y, m[2].y);
    vec3 sz = vec3(m[0].z, m[1].z, m[2].z);
    return vec3(length(sx), length(sy), length(sz));
  }

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    // Compute object scale
    vec3 objScale = getObjectScale(matWorld);
    
    // Adjust position based on scale (matching Unity shader logic)
    vec4 pos = position;
    pos.xyz /= objScale;

    float minScale = min(min(objScale.x, objScale.y), objScale.z);
    const float eps = 0.01;
    if (minScale == objScale.x) {
      pos.xyz *= objScale.x;
      if (position.y > 0.5) pos.y += (objScale.y - objScale.x) / objScale.y;
      if (position.z > eps) pos.z += (objScale.z - objScale.x) / (objScale.z * 2.0);
      else if (position.z < -eps) pos.z -= (objScale.z - objScale.x) / (objScale.z * 2.0);
    } else if (minScale == objScale.y) {
      pos.xyz *= objScale.y;
      if (position.x > eps) pos.x += (objScale.x - objScale.y) / (objScale.x * 2.0);
      else if (position.x < -eps) pos.x -= (objScale.x - objScale.y) / (objScale.x * 2.0);
      if (position.z > eps) pos.z += (objScale.z - objScale.y) / (objScale.z * 2.0);
      else if (position.z < -eps) pos.z -= (objScale.z - objScale.y) / (objScale.z * 2.0);
    } else {
      pos.xyz *= objScale.z;
      if (position.x > eps) pos.x += (objScale.x - objScale.z) / (objScale.x * 2.0);
      else if (position.x < -eps) pos.x -= (objScale.x - objScale.z) / (objScale.x * 2.0);
      if (position.y > 0.5) pos.y += (objScale.y - objScale.z) / objScale.y;
    }

    // View-space normal for matcap (matching Unity)
    vec3 worldNormal = (matWorldIT * vec4(a_normal, 0.0)).xyz;
    worldNormal = normalize(worldNormal);
    v_worldNormal = worldNormal;
    vec3 viewNormal = normalize((cc_matView * vec4(worldNormal, 0.0)).xyz);
    v_cap.xy = clamp(vec2(viewNormal.x, -viewNormal.y) * 0.5 + 0.5, 0.0, 1.0);

    // Output clip position using adjusted position
    vec4 clipPos = cc_matProj * (cc_matView * matWorld) * pos;
    
    // Build second matcap coord from adjusted local position
    vec4 adjustedPos = pos;
    adjustedPos.y -= 0.5;
    vec4 worldPos = matWorld * adjustedPos;
    vec3 worldPosNoTrans = worldPos.xyz - vec3(matWorld[3].x, matWorld[3].y, matWorld[3].z);
    worldPosNoTrans /= objScale;
    vec3 viewPos = (cc_matView * vec4(worldPosNoTrans, 0.0)).xyz;
    v_cap.zw = clamp(vec2(viewPos.x, -viewPos.y) + 0.5, 0.0, 1.0);

    return clipPos;
  }
}%

CCProgram cubeColor-fs %{
  precision highp float;
  #include <legacy/output>

  in mediump vec4 v_cap;
  in mediump vec3 v_worldNormal;
  uniform sampler2D _MatCap;

  uniform Constant {
    vec4 _Color;
    vec4 _ColorShadow;
  };

  vec4 frag () {
    vec2 mask = texture(_MatCap, v_cap.xy).xy;
    float sss = texture(_MatCap, v_cap.zw).z;

    vec3 mainColor = _Color.rgb;
    vec3 shadowColor = _ColorShadow.rgb;

    vec3 final = mix(shadowColor, mainColor, mask.y);
    final += (final + 0.2) * mask.x * 0.2;
    final += final * sss * 0.22;

    float lighting = dot(normalize(vec3(0.0, 0.75, -0.25)), normalize(v_worldNormal));
    lighting = smoothstep(1.0, 0.0, lighting);
    final = clamp(mix(final, shadowColor * final * 1.1, lighting * 0.79) , 0.0, 1.0);

    return vec4(final, 1.0);
  }
}%
