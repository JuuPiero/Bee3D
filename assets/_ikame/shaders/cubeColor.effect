CCEffect %{
  techniques:
  - name: cubeColor
    passes:
    - vert: cubeColor-vs:vert
      frag: cubeColor-fs:frag

      properties: &props
        _Color:        { value: [0.5, 0.5, 0.5, 1.0], editor: { type: color } }
        _ColorShadow:  { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
        _MatCap:       { value: black }
        _Glossiness:   { value: 2.0, editor: { type: slider, min: 0.0, max: 5.0, step: 0.1 } }
        _SpecularIntensity: { value: 1.5, editor: { type: slider, min: 0.0, max: 3.0, step: 0.1 } }
      rasterizerState:
        cullMode: back
      blendState:
        targets:
          - blend: false
}%

CCProgram cubeColor-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  out mediump vec4 v_cap; // xy: matcap by normal, zw: matcap by adjusted pos

  // Instanced attributes so different per-object params still batch
  #if USE_INSTANCING
    #pragma format(RGBA8)
    in vec4 a_instanced_color;        // _Color
    #pragma format(RGBA8)
    in vec4 a_instanced_colorShadow;  // _ColorShadow
    in vec2 a_instanced_params;       // x: _Glossiness, y: _SpecularIntensity
    in float a_instanced_enable;      // 0: use uniforms, 1: use instanced

    out vec4 v_i_color;
    out vec4 v_i_colorShadow;
    out vec2 v_i_params;
    out float v_i_enable;
  #endif

  // Compute object scale from world matrix columns
  vec3 getObjectScale(mat4 m) {
    vec3 sx = vec3(m[0].x, m[1].x, m[2].x);
    vec3 sy = vec3(m[0].y, m[1].y, m[2].y);
    vec3 sz = vec3(m[0].z, m[1].z, m[2].z);
    return vec3(length(sx), length(sy), length(sz));
  }

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    // View-space normal for matcap
    vec3 worldNormal = (matWorldIT * vec4(a_normal, 0.0)).xyz;
    worldNormal = normalize(worldNormal);
    vec3 viewNormal = normalize((cc_matView * vec4(worldNormal, 0.0)).xyz);
    // Adjust orientation: flip Y to match Unity matcap look
    viewNormal.y = -viewNormal.y;
    v_cap.xy = viewNormal.xy * 0.5 + 0.5;

    // Adjust position similar to Unity code to derive secondary mask
    vec3 objScale = getObjectScale(matWorld);
    vec4 pos = position;
    pos.xyz /= objScale;

    float minScale = min(min(objScale.x, objScale.y), objScale.z);
    if (minScale == objScale.x) {
      pos.xyz *= objScale.x;
      if (position.y > 0.5) pos.y += (objScale.y - objScale.x) / objScale.y;
      if (position.z > 0.0) pos.z += (objScale.z - objScale.x) / (objScale.z * 2.0);
      else pos.z -= (objScale.z - objScale.x) / (objScale.z * 2.0);
    } else if (minScale == objScale.y) {
      pos.xyz *= objScale.y;
      if (position.x > 0.0) pos.x += (objScale.x - objScale.y) / (objScale.x * 2.0);
      else pos.x -= (objScale.x - objScale.y) / (objScale.x * 2.0);
      if (position.z > 0.0) pos.z += (objScale.z - objScale.y) / (objScale.z * 2.0);
      else pos.z -= (objScale.z - objScale.y) / (objScale.z * 2.0);
    } else {
      pos.xyz *= objScale.z;
      if (position.x > 0.0) pos.x += (objScale.x - objScale.z) / (objScale.x * 2.0);
      else pos.x -= (objScale.x - objScale.z) / (objScale.x * 2.0);
      if (position.y > 0.5) pos.y += (objScale.y - objScale.z) / objScale.y;
    }

    // Build second matcap coord from adjusted local position, mimicking Unity
    pos.y -= 0.5;
    vec4 worldPos = matWorld * pos;
    vec3 worldPosNoTrans = worldPos.xyz - vec3(matWorld[3].x, matWorld[3].y, matWorld[3].z);
    worldPosNoTrans /= objScale;
    vec3 viewPos = (cc_matView * vec4(worldPosNoTrans, 0.0)).xyz;
    // Flip Y to keep secondary matcap in sync
    viewPos.y = -viewPos.y;
    v_cap.zw = viewPos.xy * 0.5 + 0.5;

    #if USE_INSTANCING
      v_i_color = a_instanced_color;         // normalized by RGBA8
      v_i_colorShadow = a_instanced_colorShadow;
      v_i_params = a_instanced_params;
      v_i_enable = a_instanced_enable;
    #endif

    // Output clip position from original position
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram cubeColor-fs %{
  precision highp float;

  in mediump vec4 v_cap;
  uniform sampler2D _MatCap;

  uniform Constant {
    vec4 _Color;
    vec4 _ColorShadow;
    float _Glossiness;
    float _SpecularIntensity;
  };

  // Instanced property varyings (optional)
  #if USE_INSTANCING
    in vec4 v_i_color;
    in vec4 v_i_colorShadow;
    in vec2 v_i_params;
    in float v_i_enable;
  #endif

  vec4 frag () {
    vec2 mcA = clamp(v_cap.xy, 0.0, 1.0);
    vec2 mcB = clamp(v_cap.zw, 0.0, 1.0);

    // Sample matcap masks
    vec4 texA = texture(_MatCap, mcA);
    vec4 texB = texture(_MatCap, mcB);

    float maskY = texA.g; // like tex2D(_MatCap, cap.xy).y
    float maskX = texA.r; // use red as an extra mask channel (Unity used .x)
    float sss   = texB.b; // like .z in Unity

    // Resolve base/shadow colors and parameters (instanced if enabled)
    vec3 baseCol = _Color.rgb;
    vec3 shadowCol = _ColorShadow.rgb;
    float gloss = _Glossiness;
    float specInt = _SpecularIntensity;
    #if USE_INSTANCING
      if (v_i_enable > 0.5) {
        baseCol = v_i_color.rgb;
        shadowCol = v_i_colorShadow.rgb;
        gloss = v_i_params.x;
        specInt = v_i_params.y;
      }
    #endif
    vec3 col = mix(shadowCol, baseCol, maskY);
    
    // Enhanced glossy highlights
    float glossyMask = pow(maskX, 1.0 / max(0.0001, gloss)) * specInt;
    col += (col + 0.2) * glossyMask;
    
    // Add rim lighting for glossy effect
    float rimLight = pow(maskX, 0.5) * specInt * 0.3;
    col += baseCol * rimLight;
    
    col += col * sss * 0.8;
    
    // Boost overall brightness slightly for glossy appearance
    col = pow(col, vec3(1.23));

    // Return directly to avoid sRGB decode macro issues
    return vec4(col, 1.0);
  }
}%
